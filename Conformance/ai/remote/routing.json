{
 "_note": "The model router (local-ai-engine.md §4.13, Appendix A4). THE LAW ENCODED HERE: (1) `completion` accepts a TASK HINT as the alternative to a hard model id, and resolution is DETERMINISTIC — `router.json` preference order, intersected with what is installed, filtered by required engine capabilities and by the fit verdict floor. (2) Stickiness is real economics, not a nicety: swapping models costs seconds and hundreds of megabytes, so a resident model that satisfies the task WINS over a nominally-preferred one, and the reason says `sticky-loaded`. (3) Every decision is a `routing` stream event carrying the chosen model and the reason, emitted BEFORE the first token, so a surface can always show which model answered. (4) Task ids are an OPEN vocabulary defined by the table itself — an unknown hint resolves through the declared default chain, which is what makes next year's task class a data edit instead of a release. (5) A hard `model` argument bypasses routing entirely: explicit beats clever. (6) `router.json` rides the same signed content generation as the catalog, so retuning the fleet is an OTA edit — these cases pin the semantics that edit is allowed to change.",
 "cases": [
  {
   "name": "routing: a task hint resolves through the preference order",
   "catalog": {
    "installed": [ "small", "large" ],
    "entries": [
     { "id": "small", "engine": "gguf", "format": "gguf", "perf_priors": { "phone-mid": { "decode_tps": 30 } }, "requirements": { "footprint_mb": 500, "disk_mb": 400 } },
     { "id": "large", "engine": "gguf", "format": "gguf", "perf_priors": { "phone-mid": { "decode_tps": 12 } }, "requirements": { "footprint_mb": 1200, "disk_mb": 900 } }
    ],
    "fit_policy": { "slow_decode_tps": 8 }
   },
   "device": { "class": "phone-mid", "available_memory_mb": 2000, "free_disk_mb": 8000 },
   "router": { "schema_version": 1, "tasks": { "chat": { "prefer": [ "large", "small" ], "min_verdict": "runs_slow" } }, "default": "chat", "remote": { "policy": "local" } },
   "mock": { "models": { "large": { "script": [ { "token": "hi" }, { "complete": { } } ] }, "small": { "script": [ { "token": "hi" }, { "complete": { } } ] } } },
   "steps": [
    { "call": { "scheme": "intelligence", "action": "completion", "args": { "task": "chat", "messages": [] }, "mode": "await", "as": "a" } }
   ],
   "expect": {
    "events": [ { "req": "a", "event": "routing", "data": { "task": "chat", "model": "large", "reason": "preference-order" } } ],
    "engineRequests": [ { "kind": "completion", "model": "large" } ]
   }
  },
  {
   "name": "routing: a model that does not fit is skipped for the next candidate",
