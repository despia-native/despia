   "catalog": {
    "installed": [ "small", "large" ],
    "entries": [
     { "id": "small", "engine": "gguf", "format": "gguf", "perf_priors": { "phone-low": { "decode_tps": 14 } }, "requirements": { "footprint_mb": 500, "disk_mb": 400 } },
     { "id": "large", "engine": "gguf", "format": "gguf", "perf_priors": { "phone-low": { "decode_tps": 4 } }, "requirements": { "footprint_mb": 1200, "disk_mb": 900 } }
    ],
    "fit_policy": { "slow_decode_tps": 8 }
   },
   "device": { "class": "phone-low", "available_memory_mb": 900, "free_disk_mb": 4000 },
   "router": { "schema_version": 1, "tasks": { "chat": { "prefer": [ "large", "small" ], "min_verdict": "runs_slow" } }, "default": "chat", "remote": { "policy": "local" } },
   "mock": { "models": { "small": { "script": [ { "token": "hi" }, { "complete": { } } ] } } },
   "steps": [
