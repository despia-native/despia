   },
   "steps": [ { "call": { "scheme": "intelligence", "action": "download", "args": { "model": "m1" }, "mode": "await", "as": "d" } } ],
   "expect": {
    "downloadAttempts": [
     { "url": "https://cdn.example.com/m1.gguf" },
