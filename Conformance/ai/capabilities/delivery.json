  {
   "name": "delivery: storage is accounted before a byte moves",
   "_note": "The same refusal fit.json pins, asserted from the delivery side: a model that cannot fit is refused BEFORE the request goes out, not after the disk fills.",
   "delivery": { "allowed_model_hosts": [ "cdn.example.com" ] },
   "catalog": {
    "installed": [],
    "entries": [ { "id": "big", "engine": "gguf", "format": "gguf",
                   "requirements": { "footprint_mb": 500, "disk_mb": 8000 },
