   "catalog": {
    "installed": [],
    "entries": [ { "id": "m1", "engine": "gguf", "format": "gguf",
                   "requirements": { "footprint_mb": 500, "disk_mb": 400 },
                   "perf_priors": { "phone-mid": { "decode_tps": 20 } },
