    ],
    "downloaded": [ { "model": "m1", "verified": true } ]
   }
  },
  {
   "name": "delivery: every mirror being down is a typed failure, not a silent skip",
   "delivery": { "allowed_model_hosts": [ "cdn.example.com" ] },
   "catalog": {
    "installed": [],
    "entries": [ { "id": "m1", "engine": "gguf", "format": "gguf",
