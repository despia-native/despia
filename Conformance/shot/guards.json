{
  "version": 1,
  "_note": "The SHOT GUARD SET (platform/10-screenshot-execution.md §4). Three refusals, three detectors, because they are three different failures. G-empty is the one that matters most and is the least obvious: a screen can render PERFECTLY - correct chrome, real typography, nothing thrown - and still be a store rejection because its list is empty and it says 'No data found'. Only a zero-row rule catches that, and `allowEmpty` NAMES ITS ELEMENTS rather than blanketing the shot, because a clean-inbox screen has one legitimately empty list beside a nav that must still be full. Expected values authored by hand. Runner: TS packages/kernel/test/shot-conformance.test.ts.",
  "_settleDefault": {
    "fontsReady": true,
    "imagesDecoded": true,
    "domStable": true,
    "actionsIdle": true,
    "transportIdle": true,
    "restless": []
  },
  "cases": [
    {
      "name": "a clean frame publishes",
      "report": {
        "apis": [
          {
            "as": "orders",
            "status": "ready",
            "loading": false,
            "refreshing": false,
            "blockedBy": [],
            "error": null
          }
        ],
        "collections": [
          {
            "ref": "list",
            "tag": "list",
            "rows": 3
          }
        ],
        "seamMisses": []
      },
      "expect": []
    },
    {
      "name": "THE NO-DATA-FOUND SCREENSHOT: a bound collection rendered zero rows",
      "report": {
        "apis": [],
        "collections": [
          {
            "ref": "orders",
            "tag": "list",
            "rows": 0
          }
        ],
        "seamMisses": []
      },
      "expect": [
        {
          "guard": "G-empty",
          "subject": "orders"
        }
      ]
    },
    {
      "name": "allowEmpty names the one list that is allowed to be empty",
      "allowEmpty": [
        "inbox"
      ],
      "report": {
        "apis": [],
        "collections": [
          {
            "ref": "inbox",
            "tag": "list",
            "rows": 0
          }
        ],
        "seamMisses": []
      },
      "expect": []
    },
    {
