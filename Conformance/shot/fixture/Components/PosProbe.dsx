<stack style="position: relative; width: 100%; height: 100%; background: #202430">
  <head>
    <!-- POSITIONING REGRESSION FIXTURE. Every decoration on a slide is placed by a reactive
         `left`/`top`; if that binding breaks, the whole decoration layer silently stacks down
         the left edge instead of failing, and a broken screenshot passes every guard. Two
         boxes at known percentages - one static, one reactive - must land on the arithmetic.

         It carries labels because a fixture that renders as anonymous coloured rectangles is
         one G-blank correctly refuses, and because a human opening the PNG should be able to
         see which box is which without reading this file. -->
    <variable as="px">return '30%'</variable>
    <variable as="py">return '60%'</variable>
  </head>
  <text value="Positioning probe"
        style="position: absolute; left: 6%; top: 4%; color: #ffffff; font-size: 22px;
               font-weight: 700"/>
  <stack style="position: absolute; left: 10%; top: 20%; width: 96px; height: 52px;
                border-radius: 12px; background: #ff4d4d; align-items: center;
                justify-content: center; display: flex">
    <text value="static 10/20" style="color: #2a0000; font-size: 12px; font-weight: 650"/>
  </stack>
  <stack style="position: absolute; left: {{ px }}; top: {{ py }}; width: 116px; height: 52px;
                border-radius: 12px; background: #4dff88; align-items: center;
                justify-content: center; display: flex">
    <text value="reactive 30/60" style="color: #002a10; font-size: 12px; font-weight: 650"/>
  </stack>
</stack>
