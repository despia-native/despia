          "offsetY": "0"
        },
        "unsupported": []
      }
    },
    {
      "note": "a two-argument translate fills both axes",
      "values": {
        "transform": "translate(12px, -8px)"
      },
      "expect": {
        "attributes": {
          "offsetX": "12",
          "offsetY": "-8"
        },
        "unsupported": []
      }
    },
    {
      "note": "a unitless zero is a legal length in CSS",
      "values": {
        "transform": "translateY(0)"
      },
      "expect": {
        "attributes": {
          "offsetX": "0",
          "offsetY": "0"
        },
        "unsupported": []
      }
