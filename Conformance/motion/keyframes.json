  "attributes": [
    {
      "note": "an opacity rides straight across",
      "values": {
        "opacity": "0.4"
      },
      "expect": {
        "attributes": {
          "opacity": "0.4"
        },
        "unsupported": []
      }
    },
    {
      "note": "the uniform scale the loop idiom is written with",
      "values": {
        "transform": "scale(0.82)"
      },
      "expect": {
        "attributes": {
          "scale": "0.82"
        },
        "unsupported": []
      }
    },
    {
      "note": "both halves of a pulse stop",
      "values": {
        "opacity": "1",
        "transform": "scale(1)"
      },
      "expect": {
        "attributes": {
          "opacity": "1",
          "scale": "1"
        },
        "unsupported": []
      }
    },
    {
