  "spec": [
    {
      "note": "the shorthand alone",
      "attrs": {
        "animation": "spin 2s linear infinite"
      },
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "linear",
        "iterations": -1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "longhands ALONE are a complete declaration: a name turns the off spec on",
      "attrs": {
        "animationName": "spin",
        "animationDuration": "2s"
      },
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "a longhand overrides the shorthand it follows",
      "attrs": {
        "animation": "spin 2s",
        "animationDuration": "600ms"
      },
      "expect": {
        "name": "spin",
        "duration": 600,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "infinite arrives as a longhand too",
      "attrs": {
        "animation": "spin 2s linear",
        "animationIterations": "infinite"
      },
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "linear",
        "iterations": -1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "a fractional iteration count is legal CSS",
      "attrs": {
        "animationName": "x",
        "animationDuration": "1s",
        "animationIterations": "3.5"
      },
      "expect": {
        "name": "x",
        "duration": 1000,
        "delay": 0,
        "easing": "ease",
        "iterations": 3.5,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "direction and fill longhands",
      "attrs": {
        "animationName": "x",
        "animationDuration": "1s",
        "animationDirection": "alternate",
        "animationFill": "both"
      },
      "expect": {
        "name": "x",
        "duration": 1000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "alternate",
        "fill": "both",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "a bezier easing longhand keeps its commas",
      "attrs": {
        "animationName": "x",
        "animationDuration": "1s",
        "animationEasing": "cubic-bezier(0.5, 0, 0.5, 1)"
      },
      "expect": {
        "name": "x",
        "duration": 1000,
        "delay": 0,
        "easing": "cubic-bezier(0.5, 0, 0.5, 1)",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "play-state pauses without turning the animation off",
      "attrs": {
        "animation": "spin 2s linear infinite",
        "animationPlayState": "paused"
      },
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "linear",
        "iterations": -1,
        "direction": "normal",
        "fill": "none",
        "paused": true,
        "none": false
      }
    },
    {
      "note": "and the longhand can un-pause the shorthand",
      "attrs": {
        "animation": "spin 2s paused",
        "animationPlayState": "running"
      },
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "`none` as a name is the off switch, not an animation called none",
      "attrs": {
        "animationName": "none",
        "animationDuration": "2s"
      },
      "expect": {
        "name": "",
        "duration": 2000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": true
      }
    },
    {
      "note": "duration without a name runs nothing",
      "attrs": {
        "animationDuration": "2s",
        "animationIterations": "infinite"
      },
      "expect": {
        "name": "",
        "duration": 2000,
        "delay": 0,
        "easing": "ease",
        "iterations": -1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": true
      }
    },
    {
      "note": "no animation attributes at all",
      "attrs": {},
      "expect": {
        "name": "",
        "duration": 0,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": true
      }
    },
    {
      "note": "an unknown enum word is ignored, never adopted",
      "attrs": {
        "animationName": "x",
        "animationDuration": "1s",
        "animationDirection": "sideways",
        "animationFill": "sometimes"
      },
      "expect": {
        "name": "x",
        "duration": 1000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    }
