{
  "_schema": "despia-motion-v1",
  "version": 1,
  "_note": "The keyframe sampler (runtime-pressure R28): `@keyframes` plus an `animation` shorthand, folded to the values one frame shows. THE REFERENCE IS THE BROWSER - the web renderer never calls this core, because a browser owns its own animations, so every expectation here is what CSS itself does and the two native runtimes are judged against it. Only `opacity` and `transform` animate: they are the compositor properties both native bridges already apply without a layout pass, and every other property is DROPPED and REPORTED rather than half-applied, because an animated `width` that only moves on the web is the exact defect this corpus exists to end. `iterations: -1` is `infinite` (JSON has no spelling for it and each language has its own). Values format the way the scroll-linked plane's do: four decimals, trailing zeros trimmed, negative zero normalised, because three languages compare these strings against this file. The `attributes` group is the last mile: a native renderer has no `transform` attribute, it has `opacity`, `rotation`, uniform `scale` and `offsetX`/`offsetY`, so a sampled frame is DECOMPOSED into those. The decomposition is exact or refused - CSS composes transforms leftmost-outermost and the native ladder is fixed at rotation -> scale -> offset, so a translate must come first (a uniform scale and a rotation about one centre commute, so those two are free), one occurrence per family, and anything else yields no attributes and is reported.",
  "animatable": [
    "opacity",
    "transform"
  ],
  "animationKeys": [
    "animation",
    "animationName",
    "animationDuration",
    "animationDelay",
    "animationEasing",
    "animationIterations",
    "animationDirection",
    "animationFill",
    "animationPlayState"
  ],
  "easings": {
    "linear": [
      0,
      0,
      1,
      1
    ],
    "ease": [
      0.25,
      0.1,
      0.25,
      1
    ],
    "ease-in": [
      0.42,
      0,
      1,
      1
    ],
    "ease-out": [
      0,
      0,
      0.58,
      1
    ],
    "ease-in-out": [
      0.42,
      0,
      0.58,
      1
    ]
  },
  "parse": [
    {
      "note": "the shorthand every loop is written with",
      "shorthand": "spin 2s linear infinite",
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "linear",
        "iterations": -1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "CSS orders loosely: the FIRST time is the duration whatever comes before it",
      "shorthand": "2s spin",
      "expect": {
        "name": "spin",
        "duration": 2000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "the ThinkingOrb declaration, verbatim",
      "shorthand": "pulse 1.2s ease-in-out infinite",
      "expect": {
        "name": "pulse",
        "duration": 1200,
        "delay": 0,
        "easing": "ease-in-out",
        "iterations": -1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "second time is the DELAY, and a fill word is not a name",
      "shorthand": "slide 400ms 150ms ease-out forwards",
      "expect": {
        "name": "slide",
        "duration": 400,
        "delay": 150,
        "easing": "ease-out",
        "iterations": 1,
        "direction": "normal",
        "fill": "forwards",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "a bezier carries commas and must not split",
      "shorthand": "bounce 1s cubic-bezier(0.5, 0, 0.5, 1) 3 alternate",
      "expect": {
        "name": "bounce",
        "duration": 1000,
        "delay": 0,
        "easing": "cubic-bezier(0.5, 0, 0.5, 1)",
        "iterations": 3,
        "direction": "alternate",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "a step easing, and a bare number that is an iteration count",
      "shorthand": "step 1s steps(4, end) 2",
      "expect": {
        "name": "step",
        "duration": 1000,
        "delay": 0,
        "easing": "steps(4, end)",
        "iterations": 2,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": false
      }
    },
    {
      "note": "the off switch",
      "shorthand": "none",
      "expect": {
        "name": "",
        "duration": 0,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": true
      }
    },
    {
      "note": "an empty declaration is off, not a nameless animation",
      "shorthand": "",
      "expect": {
        "name": "",
        "duration": 0,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": true
      }
    },
    {
      "note": "no name at all: nothing to run",
      "shorthand": "2s 1s ease",
      "expect": {
        "name": "",
        "duration": 0,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "normal",
        "fill": "none",
        "paused": false,
        "none": true
      }
    },
    {
      "note": "direction and fill together",
      "shorthand": "x 1s reverse both",
      "expect": {
        "name": "x",
        "duration": 1000,
        "delay": 0,
        "easing": "ease",
        "iterations": 1,
        "direction": "reverse",
        "fill": "both",
        "paused": false,
        "none": false
      }
    }
  ],
  "normalize": [
    {
      "name": "pulse",
      "rules": [
        {
          "selector": "0%, 80%, 100%",
          "declarations": {
            "opacity": "0.28",
            "transform": "scale(0.82)"
          }
        },
        {
          "selector": "40%",
          "declarations": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        }
      ],
      "expect": [
        {
          "offset": 0,
          "declarations": {
            "opacity": "0.28",
            "transform": "scale(0.82)"
          }
        },
        {
          "offset": 0.4,
          "declarations": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        },
        {
          "offset": 0.8,
          "declarations": {
            "opacity": "0.28",
            "transform": "scale(0.82)"
          }
        },
        {
          "offset": 1,
          "declarations": {
            "opacity": "0.28",
            "transform": "scale(0.82)"
          }
        }
      ]
    },
    {
      "name": "fromTo",
      "rules": [
        {
          "selector": "from",
          "declarations": {
            "opacity": "0",
            "transform": "translateX(0px)"
          }
        },
        {
          "selector": "to",
          "declarations": {
            "opacity": "1",
            "transform": "translateX(100px)"
          }
        }
      ],
      "expect": [
        {
          "offset": 0,
          "declarations": {
            "opacity": "0",
            "transform": "translateX(0px)"
          }
        },
        {
          "offset": 1,
          "declarations": {
            "opacity": "1",
            "transform": "translateX(100px)"
          }
        }
      ]
    },
    {
      "name": "mixed",
      "rules": [
        {
          "selector": "from",
          "declarations": {
            "width": "10px",
            "opacity": "0"
          }
        },
        {
          "selector": "to",
          "declarations": {
            "width": "20px",
            "opacity": "1"
          }
        }
      ],
      "expect": [
        {
          "offset": 0,
          "declarations": {
            "width": "10px",
            "opacity": "0"
          }
        },
        {
          "offset": 1,
          "declarations": {
            "width": "20px",
            "opacity": "1"
          }
        }
      ]
    },
    {
      "name": "shapeChange",
      "rules": [
        {
          "selector": "from",
          "declarations": {
            "transform": "scale(1)"
          }
        },
        {
          "selector": "to",
          "declarations": {
            "transform": "rotate(90deg) scale(2)"
          }
        }
      ],
      "expect": [
        {
          "offset": 0,
          "declarations": {
            "transform": "scale(1)"
          }
        },
        {
          "offset": 1,
          "declarations": {
            "transform": "rotate(90deg) scale(2)"
          }
        }
      ]
    }
  ],
