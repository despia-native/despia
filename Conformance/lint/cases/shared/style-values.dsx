<vstack padding="12">
  <head>
    <variable as="n">return 1</variable>
  </head>
  <text value="ok" paddingX="8" fullBleed="top" fontWeight="650"/>
  <vstack width="100%" grow="stretch"/>
  <hstack spacing="0.5rem" align="space-between"/>
  <text value="w" fontWeight="boldish" width="fit"/>
  <text value="b" fontSize="{{ n }}" radius="50%"/>
  <text value="m" marginTop="12"/>
  <hstack justifyContent="space-between" flexGrow="1"/>
  <text value="k" margin-top="12"/>
  <canvas scale="device" width="300"/>
</vstack>
