{
  "meta": {
    "contract": "Container semantics of the DSX element layer, held to the web renderer's CSS flex model (the parity reference plane). Decision rows run on :core (FlexSemanticsConformanceTest). The same situations' GEOMETRY is pinned against a real CSS engine by the browser leg: ClosedSource/scripts/dsxcss/fixtures 08-column-stretch-vs-hug, 09-max-width-align-self, 10-row-spacer-hug, 11-percent-in-hug, 12-stretch-content-contribution, 13-margins-in-column, 14-flex-grow-row, 15-divider-stretch-hug, 16-row-shrink, 17-clamped-hug-flex (npm run layout-oracle). A renderer consuming these decisions (Compose Desktop, Android :render) is measured end to end by the parity capture planes.",
    "skinTruths": {
      "stack": "flex-direction: column; align-items: start (children hug)",
      "hstack": "flex-direction: row; align-items: center",
      "scroll": "flex-direction: column; no align-items (flex default: children stretch)",
      "spacer": "flex: 1 1 0 (absorbs only extra main-axis space)",
      "grow": "width:100% children fill, then clamp under their own max-width; align-self places the element"
    }
  },
  "panes": [
    {
      "name": "head is not a pane",
      "children": [
        "head",
        "scroll",
        "scroll",
        "scroll"
      ],
      "expect": [
        1,
        2,
        3
      ]
    },
    {
      "name": "declarations are not panes",
      "children": [
        "variable",
        "watch",
        "stack"
      ],
      "expect": [
        2
      ]
    },
    {
      "name": "declaration between panes",
      "children": [
        "scroll",
        "api",
        "scroll"
      ],
      "expect": [
        0,
        2
      ]
    },
    {
      "name": "slot renders content and stays a pane",
      "children": [
        "slot",
        "stack"
      ],
      "expect": [
        0,
        1
      ]
    },
    {
      "name": "all panes when nothing declares",
      "children": [
        "stack",
        "stack"
      ],
      "expect": [
        0,
        1
      ]
    }
  ],
