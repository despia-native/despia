<scroll style="background: background">
<head>
  <!--
    Parity fixture: the TYPE-RAMP SPECIMEN. Every step of the ramp the starter
    actually uses (footnote 0.8125rem up through the 3rem display), each at its
    working weight and tracking, then the semantic color roles on their canonical
    surfaces. Type metrics carry the platform-font tolerance of the contract; the
    color rows must resolve EXACTLY.
  -->
</head>
<stack style="gap: 2rem; padding: 2rem 1.5rem 3rem; max-width: 40rem; align-self: center; width: 100%">

  <stack style="gap: 0.75rem">
    <text value="RAMP" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <text value="Display 48 / 800" style="font-size: 3rem; font-weight: 800; letter-spacing: -0.03em"/>
    <text value="Title 28 / 700" style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em"/>
    <text value="Heading 20 / 700" style="font-size: 1.25rem; font-weight: 700; letter-spacing: -0.015em"/>
    <text value="Emphasis 18 / 600" style="font-size: 1.125rem; font-weight: 600"/>
    <text value="Brand 17 / 700" style="font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.01em"/>
    <text value="Body 16 / 400 sets the reading measure for every screen."/>
    <text value="Callout 15 / 500" style="font-size: 0.9375rem; font-weight: 500"/>
    <text value="Subhead 14 / 400" style="font-size: 0.875rem"/>
    <text value="Footnote 13 / 400" style="font-size: 0.8125rem"/>
    <text value="CAPTION 12 / 600 TRACKED" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em"/>
  </stack>

  <stack style="gap: 0.75rem">
    <text value="ROLES" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <stack style="gap: 0.375rem">
      <text value="Label is the primary ink."/>
      <text value="Secondary carries supporting copy." style="color: secondary"/>
      <text value="Tertiary is for metadata and hints." style="color: tertiary"/>
      <text value="Accent marks the interactive voice." style="color: accent"/>
      <text value="Destructive warns before loss." style="color: destructive"/>
    </stack>
  </stack>

  <stack style="gap: 0.75rem">
    <text value="SURFACES" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: tertiary"/>
    <stack style="border-radius: 14px; background: groupedBackground; padding: 1rem">
      <text value="groupedBackground"/>
    </stack>
    <stack style="border-radius: 14px; background: secondaryGroupedBackground; padding: 1rem">
      <text value="secondaryGroupedBackground"/>
    </stack>
    <stack style="border-radius: 14px; background: fill; padding: 1rem">
      <text value="fill" style="color: secondary"/>
    </stack>
    <divider/>
  </stack>
</stack>
</scroll>
