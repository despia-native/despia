  "parse": [
    {
      "name": "#FFF",
      "input": "#FFF",
      "expect": {
        "rgba": {
          "r": 255,
          "g": 255,
          "b": 255,
          "a": 255
        },
        "hex": "#FFFFFF",
        "hexWithAlpha": "#FFFFFF",
        "name": "white"
      }
    },
    {
      "name": "#fff",
      "input": "#fff",
      "expect": {
        "rgba": {
          "r": 255,
          "g": 255,
          "b": 255,
          "a": 255
        },
        "hex": "#FFFFFF",
        "hexWithAlpha": "#FFFFFF",
        "name": "white"
      }
    },
    {
      "name": "#FFFF",
      "input": "#FFFF",
      "expect": {
        "rgba": {
          "r": 255,
          "g": 255,
          "b": 255,
          "a": 255
        },
        "hex": "#FFFFFF",
        "hexWithAlpha": "#FFFFFF",
        "name": "white"
      }
    },
    {
      "name": "#0A84FF",
      "input": "#0A84FF",
      "expect": {
        "rgba": {
          "r": 10,
          "g": 132,
          "b": 255,
          "a": 255
        },
        "hex": "#0A84FF",
        "hexWithAlpha": "#0A84FF",
        "name": "turquoise"
      }
    },
    {
      "name": "#0a84ff80",
      "input": "#0a84ff80",
      "expect": {
        "rgba": {
          "r": 10,
          "g": 132,
          "b": 255,
          "a": 128
        },
        "hex": "#0A84FF",
        "hexWithAlpha": "#0A84FF80",
        "name": "turquoise"
      }
    },
    {
      "name": "#F0A",
      "input": "#F0A",
      "expect": {
        "rgba": {
          "r": 255,
          "g": 0,
          "b": 170,
          "a": 255
        },
        "hex": "#FF00AA",
        "hexWithAlpha": "#FF00AA",
        "name": "magenta"
      }
    },
    {
      "name": "#GGG",
      "input": "#GGG",
      "expect": null
    },
    {
      "name": "0A84FF",
      "input": "0A84FF",
      "expect": null
    },
    {
      "name": "#12345",
      "input": "#12345",
      "expect": null
