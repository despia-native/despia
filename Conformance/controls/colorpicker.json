    {
      "name": "#000000",
      "input": "#000000",
      "expect": {
        "rgba": {
          "r": 0,
          "g": 0,
          "b": 0,
          "a": 255
        },
        "hex": "#000000",
        "hexWithAlpha": "#000000",
        "name": "black"
      }
    },
    {
      "name": "#00000000",
      "input": "#00000000",
      "expect": {
        "rgba": {
          "r": 0,
          "g": 0,
          "b": 0,
          "a": 0
        },
        "hex": "#000000",
        "hexWithAlpha": "#00000000",
        "name": "black"
      }
    }
  ],
  "nearestName": [
    {
      "name": "#FF0000",
      "input": "#FF0000",
      "expect": "red"
    },
    {
      "name": "#FE0203",
      "input": "#FE0203",
      "expect": "red"
    },
    {
      "name": "#0A84FF",
      "input": "#0A84FF",
      "expect": "turquoise"
    },
    {
      "name": "#123456",
      "input": "#123456",
      "expect": "navy"
    },
    {
      "name": "#FFFFFF",
      "input": "#FFFFFF",
      "expect": "white"
    },
    {
      "name": "#FAFAFA",
      "input": "#FAFAFA",
      "expect": "white"
    },
    {
      "name": "#000000",
      "input": "#000000",
      "expect": "black"
    },
    {
      "name": "#7F7F7F",
      "input": "#7F7F7F",
      "expect": "gray"
    },
    {
      "name": "#FFD700",
      "input": "#FFD700",
      "expect": "gold"
    },
    {
      "name": "#4B0082",
      "input": "#4B0082",
      "expect": "indigo"
    },
    {
      "name": "#EC4899",
      "input": "#EC4899",
      "expect": "tan"
    },
    {
      "name": "#14B8A6",
      "input": "#14B8A6",
      "expect": "teal"
    }
  ],
  "swatches": [
    {
      "name": "a plain list",
      "swatches": "#FF0000,#00FF00,#0000FF",
      "alpha": false,
      "expect": [
        "#FF0000",
        "#00FF00",
        "#0000FF"
      ]
    },
    {
      "name": "pipes are accepted too",
      "swatches": "#FF0000|#00FF00",
      "alpha": false,
      "expect": [
        "#FF0000",
        "#00FF00"
      ]
    },
    {
      "name": "invalid entries are dropped",
      "swatches": "#FF0000,notacolor,#00FF00",
      "alpha": false,
      "expect": [
        "#FF0000",
        "#00FF00"
      ]
    },
    {
      "name": "duplicates collapse",
      "swatches": "#FF0000,#ff0000,#F00",
      "alpha": false,
      "expect": [
        "#FF0000"
      ]
    },
    {
      "name": "alpha is dropped when alpha is off",
      "swatches": "#FF000080,#00FF00",
      "alpha": false,
      "expect": [
        "#FF0000",
        "#00FF00"
      ]
    },
    {
      "name": "alpha is kept when alpha is on",
      "swatches": "#FF000080,#00FF00",
      "alpha": true,
      "expect": [
        "#FF000080",
        "#00FF00"
      ]
    },
    {
      "name": "empty",
      "swatches": null,
      "alpha": false,
      "expect": []
    }
  ],
  "mode": [
    {
      "mode": null,
      "alpha": false,
      "swatchCount": 0,
      "expect": {
        "mode": "wheel",
        "webNeedsCustomPanel": false
      }
    },
    {
      "mode": null,
      "alpha": false,
      "swatchCount": 3,
      "expect": {
        "mode": "swatches",
        "webNeedsCustomPanel": true
      }
    },
    {
      "mode": "wheel",
      "alpha": false,
      "swatchCount": 3,
      "expect": {
