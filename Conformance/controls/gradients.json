{
  "version": 1,
  "_schema": "despia-gradient-resolution-v1",
  "_note": "The U07 gradient pure core. THE ANGLE CONVENTION IS PINNED HERE because CSS and SwiftUI disagree: 0deg points UP and increases CLOCKWISE (the CSS convention), and every target converts at its own boundary. The three legacy direction tokens are kept as exact aliases (vertical=180, horizontal=90, diagonal=135) and the default with neither declared stays vertical, so no shipped app changes appearance. Mesh degrades to a DECLARED radial stack rather than a blank, and the fallback is pinned here rather than left incidental.",
  "types": [
    "linear",
    "radial",
    "angular",
    "mesh"
  ],
  "directionAliases": {
    "vertical": 180.0,
    "horizontal": 90.0,
    "diagonal": 135.0
  },
  "defaults": {
    "type": "linear",
    "angle": 180.0,
    "center": {
      "x": 0.5,
      "y": 0.5
    },
    "radius": 0.5
  },
  "cases": [
    {
      "name": "the bare two-colour shorthand is unchanged: vertical",
      "attrs": {
        "gradient": "#FF2D55|#0A84FF"
      },
      "expect": {
        "type": "linear",
        "colors": [
          "#FF2D55",
          "#0A84FF"
        ],
        "stops": [
          0.0,
          1.0
        ],
        "angle": 180.0,
        "start": {
          "x": 0.5,
          "y": 0.0
        },
        "end": {
          "x": 0.5,
          "y": 1.0
        },
        "center": {
          "x": 0.5,
          "y": 0.5
        },
        "radius": 0.5,
        "valid": true,
        "mesh": null,
        "meshFallback": null
      }
    },
    {
