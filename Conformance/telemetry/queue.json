    {
      "fingerprint": "dom|render_failed|Checkout.dsx:#",
      "rate": 0.0,
      "expect": false
    },
    {
      "fingerprint": "dom|render_failed|Checkout.dsx:#",
      "rate": 0.5,
      "expect": false
    },
    {
      "fingerprint": "app|crash|SIGSEGV at <addr>",
      "rate": 0.5,
      "expect": false
    },
    {
      "fingerprint": "telemetry|queue_full|",
      "rate": 0.5,
      "expect": true
    },
    {
      "fingerprint": "a",
      "rate": 0.25,
      "expect": true
    },
    {
      "fingerprint": "b",
      "rate": 0.25,
      "expect": false
    },
    {
      "fingerprint": "c",
      "rate": 0.1,
      "expect": false
    },
    {
      "fingerprint": "d",
      "rate": 0.9,
      "expect": false
    },
    {
      "fingerprint": "app|crash|SIGSEGV at <addr>",
      "rate": 1.0,
      "expect": true
    },
    {
      "fingerprint": "e",
      "rate": 0.9,
      "expect": true
    }
  ],
  "backoff": [
    {
      "attempt": 0,
      "expect": 0
    },
    {
      "attempt": 1,
      "expect": 1000
    },
    {
      "attempt": 2,
      "expect": 2000
    },
    {
      "attempt": 3,
      "expect": 4000
