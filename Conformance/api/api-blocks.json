  {
   "name": "gate-ambient-planes-are-never-holes",
   "_note": "doc 11's AMBIENT CARVE-OUT, and the only row that pins it on a plane other than const. dsx.const/env/global/screen/source/app/route/cookie/query/params/path and platform/os are TYPED-ABSENT by law (durability P4): an absent one interpolates EMPTY and is a VALUE, not a value that is coming. Value-presence gating (rule 2) is for the REACTIVE scope only - surface variables, component attributes, sibling <api> blocks. Without this carve-out const-materializes-into-request and gate rule 2 contradict each other, and every app reading dsx.global.* in a url would deadlock on first mount.",
   "spec": {
    "as": "feed",
    "url": "/api/feed?g={{ dsx.global.dsx_missing_ambient_probe }}"
   },
   "scope": {},
   "responses": [
    {
     "ok": true,
     "status": 200,
     "data": {
      "n": 7
     }
    }
   ],
   "steps": [
    {
     "settle": true
    }
   ],
   "expect": {
    "feed.data.n": 7,
    "feed.status": "ready",
    "feed.loading": false,
    "feed.blockedBy.length": 0
   },
   "expectCalls": [
    "/api/feed?g="
   ],
   "expectEvents": [
    "success"
   ]
  },
  {
   "name": "gate-ambient-hole-never-lands-in-blockedby",
   "_note": "The mixed url: ONE ambient hole + ONE reactive hole. The block gates on the reactive half only, and blockedBy names `term` - never the ambient plane - so a developer reading the gate is pointed at the value they actually control. When `term` arrives the request fires ONCE, with the ambient half still empty.",
   "spec": {
    "as": "feed",
    "url": "/api/feed?g={{ dsx.global.dsx_missing_ambient_probe }}&q={{ term }}"
   },
   "scope": {
    "term": null
   },
   "responses": [
    {
     "ok": true,
     "status": 200,
     "data": {
      "n": 2
     }
    }
   ],
   "steps": [
    {
     "settle": true
    },
    {
     "set": {
      "path": "term",
      "value": "cats"
     }
    },
    {
     "settle": true
    }
   ],
   "expect": {
    "feed.data.n": 2,
    "feed.status": "ready",
    "feed.blockedBy.length": 0
   },
   "expectCalls": [
    "/api/feed?g=&q=cats"
   ],
   "expectEvents": [
    "success"
   ]
  },
