     { "scheme": "dsx", "event": "error", "data": { "code": "model_download_failed", "message": "The model host timed out.", "recoverable": true, "scheme": "errfx.mirror", "origin": "raised", "data": { "id": "job-7", "errorCode": 3, "errorMessage": "the model host timed out" } } }
    ],
    "ledger": [
