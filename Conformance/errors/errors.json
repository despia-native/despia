   "_note": "P3 ADOPTION (error-system.md \u00a74 P3) \u2014 the law the module migration rests on: a module whose CALL already settled can STILL report through the ambient hat. Every streaming/fire-and-forget module resolves immediately (`{ started: true }`, or a bare resolve for a job whose results ride events) and then discovers the failure later, with no caller left to settle. The settle guard is per-CALL and never gags the module handle, so the late emission records normally as origin 'raised' \u2014 and it is an AMBIENT emission, not a call failure, so `module.callFailed` stays silent. Without this the LocalAI/Vision migration would drop every out-of-band failure on the floor.",
   "name": "ambient-emission-outlives-its-settled-call",
   "register": [
    { "scheme": "errfx.stream", "actions": { "start": { "resolve": { "started": true } } } }
   ],
   "steps": [
    { "call": { "scheme": "errfx.stream", "action": "start", "mode": "await" } },
    { "emit": { "scheme": "errfx.stream", "code": "job_failed", "message": "the job died after it started", "recoverable": true, "data": { "id": "job-1" } } }
   ],
   "expect": {
    "callErrors": [],
    "ledger": [
     { "code": "job_failed", "message": "the job died after it started", "recoverable": true, "data": { "id": "job-1" }, "scheme": "errfx.stream", "origin": "raised" }
    ],
    "hooks": {
     "module.error": [ { "code": "job_failed", "scheme": "errfx.stream", "origin": "raised" } ],
     "module.callFailed": []
    },
    "stateDelta": { "dsx.errorCount": 1 }
   }
  },
