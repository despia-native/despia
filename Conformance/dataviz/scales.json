{
  "version": 1,
  "_note": "SCALES AND TICKS - the arithmetic every renderer must agree on before a single pixel is drawn. Different tick counts on different platforms is the classic charting drift: the same data shows 5 gridlines on iOS and 6 on Android and nobody notices until a customer screenshots both. Pinned here: the decimal-exponent and power-of-ten primitives (computed by integer loops, NEVER by log10/pow, because libm rounding differs between platforms and floor(log10(1000)) is allowed to be 2), Heckbert nice numbers, the loose-labelling linear domain (the domain EXTENDS to the nice bounds), the d3-shaped band scale, the log decade ladder with its typed refusal on a non-positive domain, and the fixed-duration time ladder (ticks stay INSIDE the domain; no calendar months, because a month is not a duration). Twins: TS @despia/kernel dataviz.ts, Kotlin :core DataViz.kt, Swift Engine/iOS DataViz.swift.",
  "tolerance": 1e-09,
  "decExp": [
    {
      "name": "one",
      "x": 1.0,
      "expect": 0
    },
    {
      "name": "ten",
      "x": 10.0,
      "expect": 1
    },
    {
      "name": "a thousand is exponent three, never two",
      "x": 1000.0,
      "expect": 3
    },
    {
      "name": "just under a thousand",
      "x": 999.9,
      "expect": 2
    },
    {
      "name": "a tenth",
      "x": 0.1,
      "expect": -1
    },
    {
      "name": "a hundredth",
      "x": 0.01,
      "expect": -2
    },
    {
      "name": "a half",
      "x": 0.5,
      "expect": -1
    },
    {
      "name": "twelve",
      "x": 12.0,
      "expect": 1
    }
  ],
  "pow10": [
    {
      "name": "zero",
      "n": 0,
      "expect": 1.0
    },
    {
      "name": "three",
      "n": 3,
      "expect": 1000.0
    },
    {
      "name": "minus two",
      "n": -2,
      "expect": 0.01
    },
    {
      "name": "minus one",
      "n": -1,
      "expect": 0.1
    }
  ],
