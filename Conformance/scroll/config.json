   "attributes": {},
   "expect": {
    "axis": "vertical",
    "bind": null,
    "indicators": true,
    "bounces": null,
    "paging": false,
    "snap": "none",
    "keyboardDismiss": "interactive",
    "overscroll": "auto",
    "contentInset": {
     "top": 0.0,
     "right": 0.0,
     "bottom": 0.0,
     "left": 0.0
    },
    "maintainPosition": false,
    "threshold": 0.0
   }
  },
