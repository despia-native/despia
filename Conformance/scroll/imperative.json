    "y": 600,
    "viewportWidth": 390,
    "viewportHeight": 800,
    "contentWidth": 390,
    "contentHeight": 2000
   },
   "axis": "vertical",
   "expect": {
    "x": 0.0,
    "y": 1200.0,
    "animated": true
   }
  },
