    {
      "name": "entry-declared-input-binds-the-host-payload",
      "_note": "THE ENTRY CALL. A host (HTTP request, CLI command, queue message) invokes an action with a payload and has no caller scope. A declared input names a payload KEY here; evaluating it as an expression against nothing would bind the absent sentinel and silently discard what the host sent.",
      "actions": {
        "create": {
          "inputs": {
            "title": "title",
            "total": "total"
          },
          "body": "dsx.variable.gotTitle = title; dsx.variable.gotTotal = total"
        }
      },
      "scope": {},
      "runAction": "create",
      "runPayload": {
        "title": "a hat",
        "total": 42
      },
      "expectStore": {
        "gotTitle": "a hat",
        "gotTotal": 42
      },
      "expectEvents": []
    },
    {
      "name": "entry-undeclared-payload-key-still-binds",
      "_note": "Declaring some inputs does not turn the payload into an allowlist — an action that declares one input still sees the rest of what the host sent.",
      "actions": {
        "create": {
          "inputs": {
            "title": "title"
          },
          "body": "dsx.variable.a = title; dsx.variable.b = extra"
        }
      },
      "scope": {},
      "runAction": "create",
      "runPayload": {
        "title": "hat",
        "extra": 7
      },
      "expectStore": {
        "a": "hat",
        "b": 7
      },
      "expectEvents": []
    },
    {
      "name": "entry-declared-input-the-payload-omits-is-absent",
      "_note": "A declared input is ALWAYS bound, so a body never reads an unbound name: the one the host omitted reads as absent rather than as a missing variable.",
      "actions": {
        "create": {
          "inputs": {
            "title": "title",
            "total": "total"
          },
          "body": "dsx.variable.gotTitle = title; dsx.variable.gotTotal = total"
        }
      },
      "scope": {},
      "runAction": "create",
      "runPayload": {
        "title": "hat"
      },
      "expectStore": {
        "gotTitle": "hat",
        "gotTotal": null
      },
      "expectEvents": []
    },
    {
      "name": "entry-input-expression-fills-a-default-from-the-store",
      "_note": "The expression is not ignored at an entry, it is the FALLBACK: a payload that is silent about an input lets its expression resolve against the store, which is how a declared default survives the entry path.",
      "actions": {
        "page": {
          "inputs": {
            "limit": "defaults.limit"
          },
          "body": "dsx.variable.used = limit"
        }
