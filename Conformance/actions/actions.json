{
  "_note": "Action/workflow runner corpus — see README.md. Actions ARE workflows: they chain, call each other with args, sequence, branch, loop, and emit events; recursion is bounded at 32 frames. Synchronous grammar only (deterministic on every runtime).",
  "cases": [
    {
      "name": "action-calls-action-chain",
      "actions": {
        "start": {
          "body": "dsx.variable.a = 1; dsx.action.next()"
        },
        "next": {
          "body": "dsx.variable.b = dsx.variable.a + 1; dsx.action.finish()"
        },
        "finish": {
          "body": "dsx.variable.c = dsx.variable.b + 1"
        }
      },
      "scope": {},
      "run": "start",
      "expectStore": {
        "a": 1,
        "b": 2,
        "c": 3
      },
      "expectEvents": []
    },
    {
      "name": "action-passes-args-to-action",
