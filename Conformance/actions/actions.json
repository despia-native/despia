    },
    "finish": {
     "body": "dsx.variable.c = dsx.variable.b + 1"
    }
   },
   "scope": {},
   "run": "start",
   "expectStore": {
    "a": 1,
    "b": 2,
    "c": 3
   },
   "expectEvents": []
  },
