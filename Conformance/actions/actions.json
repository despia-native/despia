   "name": "url-searchparams-set-resyncs-href",
   "_note": "A mutation through `.searchParams` must resync the OWNING url's `href` and `search`. Mutating the params dict alone leaves the url describing a query it no longer has, and `href` is what callers pass to fetch/navigate.",
   "actions": {
    "start": {
     "body": "dsx.variable.u = new URL('https://example.com/checkout?plan=free'); dsx.variable.u.searchParams.set('plan', 'pro'); dsx.variable.href = dsx.variable.u.href; dsx.variable.search = dsx.variable.u.search; dsx.variable.read = dsx.variable.u.searchParams.get('plan')"
    }
   },
   "scope": {},
   "run": "start",
   "expectStore": {
    "href": "https://example.com/checkout?plan=pro",
    "search": "?plan=pro",
    "read": "pro"
   },
   "expectEvents": []
  },
