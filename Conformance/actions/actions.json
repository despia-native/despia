      "name": "entry-payload-beats-the-input-expression",
      "_note": "And when the host DID send it, the payload wins over the fallback — otherwise a store variable that happens to share a name would silently override a request.",
      "actions": {
        "page": {
          "inputs": {
            "limit": "defaults.limit"
          },
          "body": "dsx.variable.used = limit"
