   "name": "url-searchparams-append-resyncs-href",
   "_note": "append keeps existing pairs and still resyncs the parent.",
   "actions": {
    "start": {
     "body": "dsx.variable.u = new URL('https://example.com/s?a=1'); dsx.variable.u.searchParams.append('b', '2'); dsx.variable.href = dsx.variable.u.href; dsx.variable.search = dsx.variable.u.search"
    }
   },
   "scope": {},
   "run": "start",
