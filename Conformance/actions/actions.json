        "sign": "positive"
      },
      "expectEvents": []
    },
    {
      "name": "loop-invokes-an-action-per-iteration",
      "_note_idiom": "for…of remains the first-choice loop idiom, and a classic `for (let i=0; i<n; i++)` is now PORTABLE TOO: `let`/`const` declarations (incl. the classic-for init) register as AUTHORED LOCALS, and an assignment to an authored local writes the LOCAL on every runtime - the store-always contract now applies only to names that are not authored locals (entry-payload keys, item fields). The old trap (native `x=e` always wrote the store, so the `let i` local shadowed the read and the loop spun to the budget) is retired; see classic-for-let-counter-is-local.",
      "actions": {
        "fill": {
          "body": "for (const n of [0, 1, 2]) { dsx.action.pushOne({ v: n }) }"
        },
        "pushOne": {
          "body": "dsx.variable.items.push(v)"
        }
      },
      "scope": {
        "items": []
      },
      "run": "fill",
      "expectStore": {
        "items": [
          0,
          1,
          2
        ]
      },
      "expectEvents": []
    },
    {
      "name": "workflow-emits-events-in-order",
      "actions": {
        "publish": {
          "body": "dsx.event('started', { at: 1 }); dsx.variable.step = 1; dsx.action.done()"
        },
        "done": {
          "body": "dsx.event('finished', { at: 2 }); dsx.variable.step = 2"
        }
      },
      "scope": {},
      "run": "publish",
      "expectStore": {
        "step": 2
      },
      "expectEvents": [
        "started",
        "finished"
      ]
    },
