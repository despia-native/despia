    {
      "name": "destructuring-assignment-swaps-store-vars",
      "_note": "syntax-005 at the RUNNER level: in a native action `x = e` writes the STORE, and the declaration-less pattern write routes each name exactly as that assignment would — so a swap swaps store vars. RHS evaluates ONCE before any binding.",
      "actions": {
        "swap": {
          "body": "[a, b] = [b, a]"
        }
      },
      "scope": {
        "a": 1,
        "b": 2
      },
      "run": "swap",
