        "outer": {
          "body": "dsx.action.add({ x: 5, y: 7 })"
        },
        "add": {
          "body": "dsx.variable.sum = x + y"
        }
      },
      "scope": {},
      "run": "outer",
      "expectStore": {
        "sum": 12
      },
      "expectEvents": []
    },
