      "actions": {
        "start": {
          "body": "dsx.variable.u = new URL('https://example.com/s?only=1'); dsx.variable.u.searchParams.delete('only'); dsx.variable.href = dsx.variable.u.href; dsx.variable.search = dsx.variable.u.search"
