    {
      "name": "an unrealised destination cross-fades from the SOURCE geometry, never to a zero rect",
      "_pins": "the case every naive implementation gets wrong: a virtualised list or a still-loading image has no destination frame yet, so the destination geometry IS the source geometry and the mode is forced to crossfade. Animating to a zero rect looks like the image collapsing into nothing.",
      "source": [
        {
          "id": "cover-9",
          "frame": {
            "x": 12,
            "y": 240,
            "width": 80,
            "height": 80
          },
          "radius": 12,
          "opacity": 1,
          "contentMode": "fill"
        }
      ],
      "destination": [
        {
          "id": "cover-9",
          "frame": {
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0
          },
          "radius": 0,
          "opacity": 1,
          "contentMode": "fill",
          "laid": false
        }
      ],
      "expect": {
        "pairs": [
          {
            "id": "cover-9",
            "order": 0,
            "mode": "crossfade",
            "anim": null,
            "deferred": true,
            "from": {
              "x": 12.0,
              "y": 240.0,
              "width": 80.0,
              "height": 80.0,
              "radius": 12.0,
              "opacity": 1.0,
              "contentMode": "fill"
            },
            "to": {
              "x": 12.0,
              "y": 240.0,
              "width": 80.0,
              "height": 80.0,
              "radius": 12.0,
              "opacity": 1.0,
              "contentMode": "fill"
            }
          }
        ],
        "unmatchedSource": [],
        "unmatchedDestination": [],
        "duplicates": []
      }
    },
