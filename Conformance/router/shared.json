{
  "version": 1,
  "_note": "U03 shared element transitions (parity/U03-shared-transitions.md) \u2014 the PURE CORE all three renderers run: the MATCHING algorithm (which `shared` ids pair across the outgoing and incoming frames), the INTERPOLATION SCHEDULE (given a progress 0..1, the frame, corner radius, opacity and content mode at that instant), and the INTERRUPTION/REVERSAL state machine. Everything platform-shaped stays outside: iOS runs it under UIViewControllerAnimatedTransitioning with a snapshot layer, Android under a shared LookaheadScope, web through the View Transitions API with a WAAPI FLIP fallback. An unmatched id is NEVER an error \u2014 it takes the ordinary frame transition. The single acceptance test is interruption: a back-swipe that starts mid-push must reverse from where the transition actually is, not snap.  Authoring: `shared` (the match id, unique within a frame), `sharedAnim` (inherits the frame's anim), `sharedMode` (move | crossfade | clip), `sharedOrder` (z-order among several pairs).",
  "modes": [
    "move",
    "crossfade",
    "clip"
  ],
  "a11y": {
    "focus": "destination",
    "at": "start",
    "_note": "accessibility focus moves to the destination frame at transition START, not end, so a VoiceOver user is never narrating a moving snapshot."
  },
  "handoffStart": 0.6666666666666666,
  "_handoffNote": "`move` keeps the source snapshot for the whole flight and fades the destination in over the final third \u2014 the hand-off point, pinned so the three renderers agree on when the real view takes over.",
  "tolerance": 1e-06,
  "match": [
    {
      "name": "one pair animates frame, radius, content mode and opacity",
      "_pins": "the base case: a thumbnail grows into the photo. Every interpolated property is carried by the pair, and nothing else in either frame is touched.",
      "source": [
        {
          "id": "cover-3",
          "frame": {
            "x": 12,
            "y": 240,
            "width": 80,
            "height": 80
          },
          "radius": 8,
          "opacity": 1,
          "contentMode": "fill"
        }
      ],
      "destination": [
        {
          "id": "cover-3",
          "frame": {
            "x": 0,
            "y": 0,
            "width": 390,
            "height": 300
          },
          "radius": 0,
          "opacity": 1,
          "contentMode": "fit"
        }
      ],
      "expect": {
        "pairs": [
          {
            "id": "cover-3",
            "order": 0,
            "mode": "move",
            "anim": null,
            "deferred": false,
            "from": {
              "x": 12.0,
              "y": 240.0,
              "width": 80.0,
              "height": 80.0,
              "radius": 8.0,
              "opacity": 1.0,
              "contentMode": "fill"
            },
            "to": {
              "x": 0.0,
              "y": 0.0,
              "width": 390.0,
              "height": 300.0,
              "radius": 0.0,
              "opacity": 1.0,
              "contentMode": "fit"
            }
          }
        ],
        "unmatchedSource": [],
        "unmatchedDestination": [],
        "duplicates": []
      }
    },
