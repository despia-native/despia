  "_maxStepNote": "the largest single-step |delta progress| the GESTURE window is allowed: from the interrupt that hands the transition to the finger through the release that gives it back. A snapping implementation jumps the whole remaining distance the instant the gesture starts; a reversing one never moves further than the finger did.",
  "machine": [
    {
      "name": "an uninterrupted push runs to the destination",
      "_pins": "the baseline the interruption cases are measured against.",
      "steps": [
        {
          "event": {
            "begin": "forward"
          },
          "expect": {
            "state": "running",
            "direction": "forward",
            "progress": 0.0,
            "target": 1.0,
            "remaining": 1.0,
            "outcome": null
          }
        },
        {
          "event": {
            "tick": 0.4
          },
          "expect": {
            "state": "running",
            "direction": "forward",
            "progress": 0.4,
            "target": 1.0,
            "remaining": 0.6,
            "outcome": null
          }
        },
        {
          "event": {
            "tick": 0.9
          },
          "expect": {
            "state": "running",
            "direction": "forward",
            "progress": 0.9,
            "target": 1.0,
