{
  "version": "1.4.0",
  "title": "DSX Stack — Style Property Catalog",
  "description": "Machine-readable catalog of every style attribute a DSX (Stack) element can carry, with constrained control types and allowed values — built to drive a Webflow/Craft.js-style visual style panel. Derived 1:1 from the engine parser (OpenSource/Engine/iOS/Stack.swift → StackStyle.apply / styleText / color) and OpenSource/Documentation/reference/StackReference.md. Every attribute value also accepts a {{ … }} interpolation expression (JSE); a panel can expose that as a 'bind' escape hatch per field. Kept in sync by ClosedSource/scripts/check_style_catalog.rb — see OpenSource/Skills/style-catalog.md.",
  "source": {
    "parser": "OpenSource/Engine/iOS/Stack.swift",
    "functions": [
      "StackStyle.apply",
      "StackStyle.styleText",
      "StackStyle.color"
    ],
    "reference": "OpenSource/Documentation/reference/StackReference.md",
    "maintenance": "OpenSource/Skills/style-catalog.md",
    "check": "ruby ClosedSource/scripts/check_style_catalog.rb --strict"
  },
  "conventions": {
    "units": "Lengths are in points (pt) on iOS, the same numeric value as dp on Android.",
    "booleans": "Serialized as the strings \"true\" / \"false\".",
    "unknownAttributes": "Ignored by the engine (graceful degradation).",
    "interpolation": "Any value may contain {{ expr }} and bind to the store.",
    "systemPath": "Every property carries systemPath: 'compatible' (applies ONTO the platform's system component — geometry that composes, lifecycle/motion, a11y, the variant words) or 'ejects' (paints or reshapes — authoring it moves a system-path element off the platform rendering onto the custom path; system-defaults.md 'Ejection is explicit, never silent'). Aliases inherit their property's verdict. This field is the SINGLE SOURCE OF TRUTH for the renderer ejection gates — check_style_catalog.rb cross-checks the gate word sets (iOS List allowlist, watch/wear wrist eject sets, Android SystemButton) against it, and lint_dsx.rb's ejection notice reads it. New property ⇒ classify it here (see OpenSource/Skills/style-catalog.md)."
  },
  "controlTypes": {
    "number": "Numeric input. Honors unit / min / max / step / default.",
    "length": "Numeric input that also accepts keyword tokens (see `keywords`), e.g. width can be a number or \"fit\".",
    "enum": "Single-select from `options` (value + human label). NOT free text.",
    "multiEnum": "Comma-separated multi-select from `options` (e.g. a11yTrait).",
    "color": "Color picker. Accepts a named token from `colorTokens`, #RRGGBB, #AARRGGBB, rgb(…), or rgba(…).",
    "gradient": "Ordered list (2+) of color values, serialized joined by \"|\" (e.g. \"#000|#fff\").",
    "ratio": "Aspect ratio: \"W:H\" (e.g. \"16:9\") or a bare number (e.g. 1.33).",
    "boolean": "Toggle, serialized as \"true\"/\"false\".",
    "text": "Free string (used for a11y labels etc.)."
  },
