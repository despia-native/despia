<vstack grow="true" align="center" spacing="18" padding="32" background="systemBackground">
  <vstack width="640" maxWidth="640" spacing="14" padding="28" radius="18" background="surface" borderColor="danger" borderWidth="1">
    <text value="DSX could not open this screen." fontSize="26" fontWeight="bold"/>
    <text value="The native runtime stayed on this bundled fail-closed surface." color="secondary"/>
    <text value="{{ diagnostic }}" fontDesign="monospaced" color="danger"/>
    <text value="Source: {{ source }}" fontDesign="monospaced" color="secondary"/>
  </vstack>
</vstack>
