{
  "name": "@despia-native/element",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "DSX web-component embeds (/web/13) - a thin wrapper that defines an EXPOSED DSX component as a real custom element: observed attributes from the head contract, attribute/property writes converge on the same signals, <event> dispatches CustomEvents, shadow-DOM isolation with constructable stylesheets, DSD upgrade.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/despia-native/despia.git",
    "directory": "Web/packages/element"
  },
  "homepage": "https://github.com/despia-native/despia/tree/main/Web/packages/element",
  "bugs": {
    "url": "https://github.com/despia-native/despia/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:50})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "node -e \"const f=require('node:fs');if(f.existsSync('src'))require('node:child_process').execFileSync(process.platform==='win32'?'npm.cmd':'npm',['run','build'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "@despia-native/kernel": "0.0.1",
    "@despia-native/compiler": "0.0.1",
    "@despia-native/dom": "0.0.1"
  }
}
