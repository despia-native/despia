rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dsx_note/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.owner_id;
      allow update: if request.auth != null && request.auth.uid == resource.data.owner_id
        && request.resource.data.owner_id == resource.data.owner_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.owner_id;
    }
    match /dsx_webhook_events/{docId} {
      allow read, write: if false;
    }
  }
}
