# Build context: OpenSource/Web (the workspace). The custom/docker target.
FROM node:22-alpine
WORKDIR /app
COPY . .
RUN npm install --omit=dev
RUN npm install --no-save --no-package-lock pg@^8.22.0
EXPOSE 8787
# A1 (the SITE face): set DSX_SITE_DIR to a built DSX site (`dsx build` / build:demo output,
# the directory containing registry.json) and this container serves static assets + SSR pages
# in front of the API routes. Unset — the default — is the API-only server, byte-identical to
# every deployment before the site face existed.
#   docker run -e DSX_SITE_DIR=/app/site -v ./dist:/app/site …
ENV DSX_SITE_DIR=""
CMD ["node", "packages/server/deploy/serve.ts"]
