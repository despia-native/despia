{
  "name": "dsx-web-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/kernel",
    "packages/compiler",
    "packages/dom",
    "packages/element",
    "packages/server",
    "packages/cli",
    "packages/create-dsx",
    "packages/vite-plugin"
  ],
  "scripts": {
    "build": "npm run build -w @despia/kernel && npm run build -w @despia/compiler && npm run build -w @despia/dom && npm run build -w @despia/element && npm run build -w @despia/server && npm run build -w @despia/cli && npm run build -w create-dsx && npm run build -w @despia/vite-plugin",
    "pack:check": "node scripts/verify-packages.ts",
    "cold-start": "node scripts/verify-cold-start.ts",
    "build:server-targets": "node packages/server/scripts/build-targets.ts",
    "release:test": "node --test scripts/release-packages.test.ts",
    "release:artifacts": "node scripts/release-packages.ts build",
    "release:verify": "node scripts/release-packages.ts verify",
    "dev3:release": "node ../../scripts/dev3-release-gate.mjs",
    "dev3:release:test": "node --test ../../scripts/dev3-release-gate.test.mjs",
    "test": "npm run build && npm run test:node:built && npm run browser:boot:built && npm run test:firestore",
    "test:node:built": "node scripts/run-node-tests.ts",
    "test:firestore": "node scripts/run-firestore-emulator.ts",
    "fuzz": "node --test packages/compiler/test/parser-fuzz.test.ts",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "conformance": "node --test packages/kernel/test/conformance.test.ts packages/kernel/test/motion-conformance.test.ts packages/kernel/test/input-conformance.test.ts packages/kernel/test/mcp-apps-conformance.test.ts packages/kernel/test/mcp-server-conformance.test.ts packages/dom/test/router-conformance.test.ts",
    "layout-oracle": "npm run build && node packages/dom/oracle/run.ts",
    "browser:matrix": "npm run build:demo && node scripts/run-browser-matrix.ts",
    "browser:icons": "node packages/dom/oracle/icons-browser.ts",
    "browser:boot": "npm run build && npm run browser:boot:built",
    "browser:boot:built": "node packages/dom/oracle/boot-integration-browser.ts",
    "browser:hydrate": "npm run build:demo && node packages/dom/oracle/hydrate-browser.ts",
    "browser:forms": "npm run build:demo && node packages/dom/oracle/forms-browser.ts",
    "browser:overlays": "node packages/dom/oracle/overlay-controls-browser.ts",
    "browser:scroll": "npm run build:demo && node packages/dom/oracle/scroll-restoration-browser.ts",
    "browser:data-controls": "node packages/dom/oracle/data-controls-browser.ts",
    "browser:application-controls": "node packages/dom/oracle/application-controls-browser.ts",
    "browser:media": "node packages/dom/oracle/media-surfaces-browser.ts",
    "browser:input": "npm run build:demo && node packages/dom/oracle/input-browser.ts",
    "browser:game": "npm run build:demo && node packages/dom/oracle/game-browser.ts",
    "browser:sprites": "npm run build:demo && node packages/dom/oracle/sprites-browser.ts",
    "browser:playthrough": "npm run build:demo && node packages/dom/oracle/playthrough-browser.ts",
    "browser:stress": "npm run build:demo && node packages/dom/oracle/engine-stress-browser.ts",
    "browser:soak": "npm run build:demo && node packages/dom/oracle/engine-soak-browser.ts",
    "icons:generate": "node packages/dom/bin/generate-icons.ts",
    "build:demo": "npm run build && node packages/compiler/bin/build-demo.ts",
    "build:editor-dist": "npm run build && node packages/compiler/bin/build-editor-dist.ts",
    "dsx": "node packages/cli/bin/dsx.ts",
    "create-dsx": "node packages/create-dsx/bin/create-dsx.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "pg": "^8.22.0",
    "playwright-core": "^1.53.0",
    "typescript": "^5.8.3"
  }
}
