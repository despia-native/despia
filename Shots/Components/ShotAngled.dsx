<stack id="shot-card"
       style="position: relative; width: 100%; height: 100%; overflow: hidden; background: #05121f">
  <head>
    <!-- TEMPLATE 2 - ANGLED. Adjacent slides must vary layout and device placement, or a
         five-slide strip reads as one screenshot printed five times. This one sets the
         headline hard left, tilts the device, and lets it run off the right edge, so the eye
         enters top-left and travels down-right across the slide. -->
    <attribute as="caption" sample="&quot;Know what\nyou spent&quot;"/>
    <attribute as="subcaption" sample="&quot;Totals update the second an order lands.&quot;"/>
    <attribute as="screen" sample="&quot;01-orders.png&quot;"/>
    <attribute as="tone" sample="&quot;#2f7bff&quot;"/>
    <attribute as="tone2" sample="&quot;#54e8c6&quot;"/>
  </head>

  <!-- LAYERS, NOT A GRID. A template root is a positioned box and every layer is absolutely
       placed inside it. `.dsx-zstack` is display:grid with justify-items:center and an
       auto-sized column (theme.ts), so a child asking for width:100% contributes 0 to the
       column's max-content and the whole layer collapses to zero width - which rendered a
       Play feature graphic as a flat rectangle of background colour that passed every guard.
       Positioned layers have no such circularity. -->

  <stack style="position: absolute; top: 0; left: 0; right: 0; bottom: 0">
    <ShotGlow a="{{ dsx.attribute.tone }}" b="{{ dsx.attribute.tone2 }}" c="#06182c"/>
  </stack>

  <stack style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 1">
    <vstack style="position: absolute; top: 92px; left: 40px; right: 40px; gap: 0rem">
      <text value="{{ dsx.attribute.caption }}"
            style="color: #ffffff; font-size: 42px; font-weight: 800; letter-spacing: -0.038em;
                   line-height: 1.02; white-space: pre-wrap"/>
      <text value="{{ dsx.attribute.subcaption }}"
            style="margin-top: 16px; color: rgba(255,255,255,0.64); font-size: 15px;
                   font-weight: 450; line-height: 1.4; max-width: 74%"/>
    </vstack>

    <stack style="position: absolute; left: 26%; top: 340px; width: 78%; display: flex">
      <ShotFrame screen="{{ dsx.attribute.screen }}" label="{{ dsx.attribute.caption }}"
               width="100%" radius="36px" tilt="-7deg" lift="0.65"/>
    </stack>
  </stack>
</stack>
